rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 강의 진행 상태: 누구나 읽고, 강사 구글 계정만 쓴다
    match /live/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["강사-구글-메일@gmail.com"]
        && request.resource.data.keys().hasOnly(["slide", "practice", "unlocked", "open", "running", "updatedAt"]);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
